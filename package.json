{
  "name": "lo-tool-release",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --bun astro dev --host 127.0.0.1 --port 4321",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview --host 127.0.0.1 --port 4321",
    "check": "bun --bun astro check",
    "test": "bun test tests",
    "sync": "bun scripts/sync-releases.ts",
    "verify": "bun run test && bun run check && bun run build"
  },
  "dependencies": {
    "astro": "7.4.0",
    "gsap": "3.15.0",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/bun": "1.4.3",
    "@types/semver": "7.8.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3"
  }
}
