---
import Base from '../../../layouts/Base.astro'
import {
  legalSnapshots,
  readLegalSnapshot,
  legalBlocks,
} from '../../../lib/legal-documents'
import { href } from '../../../lib/site'

export function getStaticPaths() {
  return legalSnapshots().map((version) => ({ params: { version } }))
}
const version = Astro.params.version!
const documents = readLegalSnapshot(version)
---

<Base title="绿狼工具箱使用与版权">
  <article class="legal-page shell">
    <a class="text-link" href={href()}>
      ← 返回下载页
    </a>
    <h1>绿狼工具箱使用与版权</h1>
    <p class="legal-version">版本 {version}</p>
    <nav class="legal-nav" aria-label="文档章节">
      <a href="#terms">使用与署名</a>
      <a href="#copyright">版权与投诉</a>
    </nav>
    {[
      { id: 'terms', title: '使用与署名', text: documents['TERMS.md']! },
      {
        id: 'copyright',
        title: '版权与投诉',
        text: documents['COPYRIGHT.md']!,
      },
    ].map((document) => (
      <section id={document.id}>
        <h2>{document.title}</h2>
        {legalBlocks(document.text)
          .slice(2)
          .map((block) =>
            block.kind === 'heading' ? (
              <h2>{block.text}</h2>
            ) : block.kind === 'list' ? (
              <ul>
                {block.lines.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            ) : (
              <p>{block.text}</p>
            ),
          )}
      </section>
    ))}
  </article>
</Base>
